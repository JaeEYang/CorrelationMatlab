# Python cache
.idea/
__pycache__/
*.pyc
._*
*.egg-info/

# Test tooling
.pytest_cache/
.pytest_tmp/


# ============================================================
# SCIENTIFIC / MICROSCOPE DATA
# ============================================================

# Scientific files are ignored by default elsewhere in the repository.
*.st
*.tif
*.tiff
*.mdoc
*.nav
*.mrc
*.rec

# Generated images are ignored by default elsewhere.
*.png
*.jpg
*.jpeg
*.bmp
*.webp

# data/ itself is the curated reference-data location.
# Direct files in data/ are intentionally allowed even if their
# extensions are ignored above.
!data/*

# Any directory under data/ is considered a local experimental
# dataset and must not be tracked.
data/*/